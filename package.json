{
  "name": "glow-orb-vue",
  "version": "0.9.0",
  "author": {
    "name": "Sam Carrington",
    "email": "sam@gwawr.co.uk"
  },
  "description": "A Vue 3 component reproducing the talk.deepgram.com molten-orb effect, with per-orb behavior and color individuality.",
  "license": "MIT",
  "keywords": [
    "vue",
    "vue3",
    "component",
    "animation",
    "glow",
    "orb"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samcarrington/glow-orb-vue.git"
  },
  "bugs": {
    "url": "https://github.com/samcarrington/glow-orb-vue/issues"
  },
  "homepage": "https://github.com/samcarrington/glow-orb-vue#readme",
  "type": "module",
  "main": "./dist/glow-orb-vue.cjs",
  "module": "./dist/glow-orb-vue.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/glow-orb-vue.js",
      "require": "./dist/glow-orb-vue.cjs"
    },
    "./style.css": "./dist/glow-orb-vue.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build:demo": "vite build --config demo/vite.config.pages.ts",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit",
    "format": "biome format --write .",
    "lint": "biome check --write ."
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "dependencies": {
    "culori": "4.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "22.10.0",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "5.9.3",
    "vite": "8.2.0",
    "vite-plugin-dts": "5.0.3",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "vitest": "4.1.10",
    "vue": "3.5.40",
    "vue-tsc": "3.3.9"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
